generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

enum LocationType {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum InterviewType {
  HR
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  CERTIFICATE
  OTHER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  status       UserStatus    @default(ACTIVE)
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]
  companies    Company[]
  interviews   Interview[]
  documents    Document[]
}

model Company {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  website       String?
  location      String?
  industry      String?
  contactPerson String?
  contactEmail  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  applications  Application[]

  @@unique([userId, name])
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName    String
  position       String
  location       String?
  locationType   LocationType      @default(REMOTE)
  employmentType EmploymentType    @default(FULL_TIME)
  salary         String?
  status         ApplicationStatus @default(APPLIED)
  applicationDate DateTime         @default(now())
  jobDescription String?
  jobUrl         String?
  contactPerson  String?
  contactEmail   String?
  cvUsed         String?
  notes          String?
  rating         Int               @default(3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  interviews     Interview[]
  documents      Document[]

  @@index([userId, status])
}

model Interview {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  type          InterviewType   @default(TECHNICAL)
  scheduledAt   DateTime
  location      String?
  interviewer   String?
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, scheduledAt])
}

model Document {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  fileName      String
  fileType      DocumentType @default(RESUME)
  fileUrl       String
  fileSize      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}
