# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite (Out of the box):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Example (Docker / Render / Railway / Supabase):
# DATABASE_URL="postgresql://jobtrack_user:jobtrack_password@localhost:5432/jobtrack_db?schema=public"

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE_MB=10
